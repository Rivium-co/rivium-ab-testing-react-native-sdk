{
  "name": "rivium-ab-testing-react-native",
  "version": "0.2.3",
  "description": "Rivium A/B Testing SDK for React Native - Pure TypeScript, no native modules required",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "react-native": "src/index.ts",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest"
  },
  "keywords": [
    "react-native",
    "ab-testing",
    "rivium",
    "experiments",
    "feature-flags"
  ],
  "author": "Rivium <founder@rivium.co>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rivium-co/rivium-ab-testing-react-native-sdk.git"
  },
  "homepage": "https://github.com/Rivium-co/rivium-ab-testing-react-native-sdk",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0",
    "@react-native-async-storage/async-storage": ">=1.17.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-native": "^0.72.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "typescript": "^5.0.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__tests__/mocks/react-native.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__tests__/mocks/async-storage.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "target": "ES2020",
            "lib": [
              "ES2020",
              "DOM"
            ],
            "strict": true,
            "esModuleInterop": true,
            "skipLibCheck": true,
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    }
  }
}
