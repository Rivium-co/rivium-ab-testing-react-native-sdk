{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "moduleResolution": "node",
    "jsx": "react-native",
    "outDir": "./lib",
    "declaration": true,
    "declarationDir": "./lib"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "**/*.d.ts"]
}
